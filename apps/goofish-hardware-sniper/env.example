# AI 模型
OPENAI_API_KEY=CHANGE_ME
OPENAI_BASE_URL=CHANGE_ME
OPENAI_BASE_URL_FALLBACK=
OPENAI_MODEL_NAME=CHANGE_ME

# Web 管理
SERVER_PORT=8000
WEB_USERNAME=admin
WEB_PASSWORD=CHANGE_ME

# 爬虫
RUN_HEADLESS=true
LOGIN_IS_EDGE=false
PCURL_TO_MOBILE=true
BROWSER_CDP_URL=http://host.docker.internal:9223
ACCOUNT_STATE_DIR=state

# AI 策略
AI_DEBUG_MODE=false
PROXY_URL=
ENABLE_THINKING=false
ENABLE_RESPONSE_FORMAT=true
AI_ANALYSIS_CONCURRENCY=1
AI_IMAGE_MAX_COUNT=6
AI_IMAGE_MAX_SIDE=1024
AI_IMAGE_JPEG_QUALITY=80
DETAIL_FETCH_LIMIT_PER_RUN=6
PRE_LLM_FILTER_ENABLED=true
PRE_LLM_FILTER_EXTRA_KEYWORDS=
SKIP_AI_ANALYSIS=false

# 推送（任选其一）
NTFY_TOPIC_URL=
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=
BARK_URL=
WX_BOT_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=
GOTIFY_URL=
GOTIFY_TOKEN=
WEBHOOK_URL=
WEBHOOK_METHOD=POST
WEBHOOK_CONTENT_TYPE=JSON
WEBHOOK_HEADERS=
WEBHOOK_QUERY_PARAMETERS=
WEBHOOK_BODY=

# 失败保护 / 日志
TASK_FAILURE_THRESHOLD=3
TASK_FAILURE_PAUSE_SECONDS=86400
TASK_FAILURE_GUARD_PATH=
TASK_LOG_RETENTION_DAYS=7

# 代理池轮换
PROXY_ROTATION_ENABLED=false
PROXY_ROTATION_MODE=per_task
PROXY_POOL=
PROXY_ROTATION_RETRY_LIMIT=2
PROXY_BLACKLIST_TTL=300

# 调度抖动
SCHEDULER_JITTER_MIN_SECONDS=0
SCHEDULER_JITTER_MAX_SECONDS=180
