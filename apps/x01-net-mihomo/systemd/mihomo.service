[Unit]
Description=mihomo proxy (TUN)
After=network-online.target
Wants=network-online.target

[Service]
User=mihomo
Group=mihomo
ExecStart=/home/dev/infra/net/mihomo/bin/mihomo -d /home/dev/infra/net/mihomo -f /home/dev/infra/net/mihomo/config/config.yaml
Restart=always
RestartSec=3
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW

[Install]
WantedBy=multi-user.target
